# Copy to .env and fill in your keys:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# --- General ---
ENVIRONMENT=dev                 # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=false                  # true in production (one JSON object per log line)

# Used by host-side tools. Inside docker compose this is overridden to db:5432.
DATABASE_URL=postgresql+psycopg://nexa:nexa@localhost:5433/nexa

# --- Auth ---
# Generate a real secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Web UI origin(s) allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:3001

# --- Background jobs ---
# celery = a worker processes uploads (docker compose starts one).
# inline  = process inside the upload request (no worker needed; slower uploads).
INGESTION_MODE=celery
REDIS_URL=redis://localhost:6380/0

# --- Uploads ---
MAX_UPLOAD_MB=50

# --- Embeddings ---
# openai | gemini | fake   (fake = deterministic offline embeddings, for tests only)
# Switching provider/model later means re-embedding every document (vectors from
# different models aren't comparable): `docker compose down -v`, then `make seed`.
EMBEDDING_PROVIDER=openai
# Leave empty for the provider's default:
#   openai -> text-embedding-3-small      gemini -> gemini-embedding-001
EMBEDDING_MODEL=
OPENAI_API_KEY=
# Free key: https://aistudio.google.com/apikey
# Gemini's FREE tier may use your data to improve Google's products: fine for the
# synthetic sample data, NOT for real client documents (use a paid tier for those).
GEMINI_API_KEY=

# --- Answer generation (LLM) ---
# anthropic | openai | fake
LLM_PROVIDER=anthropic
# Claude model id. Switching models is one line — e.g. claude-sonnet-5 or claude-haiku-4-5
# are cheaper; compare them with the eval harness (Week 3/6) before switching.
LLM_MODEL=claude-opus-5
# Optional: low | medium | high | xhigh | max. Leave empty for the API default (high).
LLM_EFFORT=
ANTHROPIC_API_KEY=
# If Claude's safety classifiers decline a request, retry it server-side on
# Anthropic's recommended fallback model instead of returning a refusal.
ANTHROPIC_REFUSAL_FALLBACK=true
# If you set LLM_PROVIDER=openai, set LLM_MODEL to a current OpenAI chat model id
# from https://platform.openai.com/docs/models

# --- Retrieval ---
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
# Prefix each chunk with "Document: <title> | Section: <headings>" when embedding
# and keyword-indexing it (measured: semantic Hit@1 70% -> 85%). Changing this
# needs `make reindex`.
CONTEXTUAL_HEADERS=true
# semantic | keyword | hybrid (semantic + keyword, fused with Reciprocal Rank Fusion)
RETRIEVAL_MODE=hybrid
# Passages given to the LLM.
RETRIEVAL_TOP_K=5

# --- Reranking (re-scores the top 20 hybrid results; much sharper than similarity) ---
# none | cohere | fake (fake = offline, for tests)
RERANKER_PROVIDER=cohere
# Trial key: https://dashboard.cohere.com (1,000 calls/month, 10 reranks/minute)
COHERE_API_KEY=
RERANKER_MODEL=rerank-v4.0-pro
# Client-side pacing for trial keys; set 0 with a production key.
RERANK_MAX_PER_MINUTE=10

# --- "I don't know" gates (skip the LLM when retrieval found nothing relevant) ---
# With a reranker: minimum rerank score of the best passage. Measured with
# rerank-v4.0-pro on the sample data: answerable questions scored >= 0.834,
# near-miss unanswerable ones 0.71-0.91, off-topic ~0.34. 0.80 refused none of
# the 40 answerable questions and caught half of the unanswerable ones.
MIN_RERANK_SCORE=0.80
# Without a reranker: minimum cosine similarity. Model-dependent: on the sample
# data gemini-embedding-001 scores answerable questions >= 0.57, but unanswerable
# ones up to 0.74, so similarity alone can't separate them (see
# docs/evaluation-results.md). `make eval` prints suggested values for both.
MIN_RELEVANCE_SCORE=0.30

# --- Host ports for docker compose ---
NEXA_API_PORT=8010
NEXA_WEB_PORT=3001
NEXA_DB_PORT=5433
NEXA_REDIS_PORT=6380
